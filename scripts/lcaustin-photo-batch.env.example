# Copy to ~/.config/lcaustin-photo-batch.env on the WSL machine.
# Do not commit the copied file: it contains your database credential.

export PHOTO_BATCH_ROOT='/mnt/g/Shared drives/HomepagePhoto'
export R2_PHOTO_REMOTE='r2:lcaustin-assets/uploads/photos'
export DATABASE_URI='postgresql://REPLACE_WITH_YOUR_NEON_DATABASE_URI'
export PHOTO_MAX_WIDTH=1920
export PHOTO_WEBP_QUALITY=84
